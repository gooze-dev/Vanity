[0.003557, "o", "# gooze.yaml: every key is optional; these are the defaults.\r\n# Reference: https://gooze.dev/docs/config/\r\nversion: 1                    # Config schema version.\r\noutput: .gooze-reports        # Directory where mutation reports are written.\r\nno-cache: false               # Disable incremental caching and force a full re-run.\r\nno-update-check: false        # Disable the check for a newer gooze release.\r\n\r\npaths:                        # Path selection settings.\r\n  exclude: []                 # Regular-expression patterns of files to skip (e.g. '^vendor/').\r\n\r\nrun:                          # Mutation run settings.\r\n  parallel: 1                 # Number of concurrent mutation workers.\r\n  mutation_timeout: 120       # Per-mutation timeout in seconds.\r\n  coverage_profile: ''        # Go coverage profile; mutations on uncovered lines are reported as not_covered without running tests.\r\n  diff: ''                    # Git ref to diff against; only lines changed since its merge base with HEAD are mutated. Requires gi"]
[0.004045, "o", "t. Empty runs everything.\r\n  mutagens: []                # Mutagens to run (arithmetic, boolean, numbers, comparison, logical, unary, bitwise, increment, assignment, branch, statement, loop); empty runs the default ones, all but branch, statement and loop.\r\n  workspace: overlay          # How mutants are built: overlay tests them in the project through go test -overlay, without copying it; deep-copy tests them in a per-worker copy of the project, for tests that build the project's code in a subprocess, read its source files or write next to themselves.\r\n  fail_fast: \"off\"            # When a run stops before testing every mutant: off tests them all; gate stops once a threshold can no longer be met; file skips the rest of a file once it can no longer meet threshold.file; first stops at the first surviving mutant. Untested mutants are tested by the next run.\r\n\r\nmutagen:                      # Per-mutagen settings.\r\n  comparison:                 # Settings of the comparison mutagen.\r\n    enum_bounds: false      "]
