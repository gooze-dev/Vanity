---
import BaseLayout from "@/layouts/BaseLayout.astro"
import type { Metadata } from "@/lib/metadata"

const metadata: Metadata = { robots: { index: false, follow: false } }
---
<BaseLayout metadata={metadata}>
  <div class="flex h-screen flex-col items-center justify-center text-center">
    <div>
      <h1 class="mr-5 inline-block border-r pr-6 align-top text-2xl leading-[49px]">404</h1>
      <div class="inline-block"><h2 class="font-sans text-sm leading-[49px] font-normal">This page could not be found.</h2></div>
    </div>
  </div>
</BaseLayout>
