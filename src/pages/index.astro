---
import AgentLoop from "@/components/AgentLoop.astro"
import CodeBlock from "@/components/CodeBlock.astro"
import TerminalWindow from "@/components/TerminalWindow.astro"
import Lockup from "@/components/Lockup.astro"
import MutationDiff from "@/components/MutationDiff.astro"
import NavHeader from "@/components/NavHeader.astro"
import WorksWith from "@/components/WorksWith.astro"
import Button from "@/components/ui/Button.astro"
import ClaudeCodeAnnouncement from "@/components/ClaudeCodeAnnouncement.astro"
import FaqList from "@/components/FaqList.astro"
import HeadingAnchors from "@/components/HeadingAnchors.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import type { Metadata } from "@/lib/metadata"
import { faqPageJsonLd } from "@/lib/faq"
import { recordingText } from "@/lib/recording"

// Self-canonical for the homepage. The root layout no longer sets a default
// canonical (it would leak onto every other page).
const metadata: Metadata = {
  alternates: { canonical: "/" },
};


// Q&As rendered visibly on the page AND emitted as FAQPage JSON-LD from the
// same source, so the structured data always matches what people read. Wording
// kept truthful to the CLI (e.g. the score gate is a documented CI step, not a
// built-in flag).
const faqs = [
  {
    q: "What is Gooze?",
    a: "Gooze is an open-source mutation testing tool for Go (Golang) that measures the quality of your test suite by injecting small, deliberate bugs (mutations) into your code and checking whether your tests catch them.",
  },
  {
    q: "Why is it called Gooze?",
    a: "Go + ooze. The name comes from the [mutagen ooze](https://turtlepedia.fandom.com/wiki/Mutagen) in Teenage Mutant Ninja Turtles: Gooze mutates your code to see if your tests notice. It has always been called Gooze; it was never named Ooze.",
  },
  {
    q: "Why use Gooze for Go mutation testing?",
    a: "Gooze is built for CI/CD. It has an incremental cache that re-tests only changed files, sharding across parallel CI runners, coverage-profile support that skips tests for uncovered lines, and OCI registry support to share baseline reports across teams.",
  },
  {
    q: "How can I speed up Go mutation testing with Gooze?",
    a: "Use incremental runs (Gooze caches results and re-tests only files whose source, test, or mutators changed), raise the `--parallel` worker count, or pass `--coverage-profile` so mutations on uncovered lines are reported as `not_covered` without running tests.",
  },
  {
    q: "Does Gooze run the whole test suite for every mutant?",
    a: "No. Each mutant runs `go test` only for its own package, never the whole module. A run can also be as small as you need: the cache re-tests only files that changed, `--diff origin/main` mutates only the lines a pull request changes, and `--run '^InRange$'` mutates one function. That keeps runs short enough for AI coding agents to check every edit they make.",
  },
  {
    q: "Our coverage is high but bugs still reach production. How does Gooze help?",
    a: "High line coverage only proves your code was executed, not that your assertions check the result. Gooze injects deliberate faults into your code and checks that your tests fail. A survived mutant shows code your tests run but don't check. For example, tests for a range check can run every line without trying a value exactly on a bound, and Gooze reports `if n < lo {` -> `if n <= lo {` as survived.",
  },
  {
    q: "Mutation testing is slow. Will it block our CI/CD pipeline?",
    a: "It doesn't have to. Passing a Go coverage profile skips tests for uncovered lines, the incremental cache reuses results for unchanged files, and parallel workers and sharding split the remaining work.",
  },
  {
    q: "How can we use mutation testing as an automated quality gate?",
    a: "Set a threshold: `gooze run --threshold-total 80 ./...`, or `threshold.total: 80` in `gooze.yaml`. Below it, Gooze exits with code `3` and the CI job fails, which blocks pull requests that weaken your tests. A diff threshold sets a stricter bar for the lines a pull request changes.",
  },
  {
    q: "How do we store reports across ephemeral CI runners?",
    a: "Gooze packages the reports directory as an OCI artifact. CI jobs can push and pull it to your existing container registry (such as GHCR) with `gooze report push` and `gooze report pull`, so runs share one baseline.",
  },
  {
    q: "How can developers see mutation results without waiting for CI?",
    a: "Gooze ships goozels, a language server (LSP) that surfaces mutation results inline in editors such as VS Code, Neovim and GoLand, so developers can fix weak tests before they commit.",
  },
];


const faqJsonLd = faqPageJsonLd(faqs);
// Real output only: the terminal and the diff read the recordings.
const reportLines = recordingText("calc-report-view").split("\n")
const firstSurvivor = reportLines.find((line) => line.includes(": survived (")) ?? ""

const mechanisms = [
  { title: "Re-test only what changed", text: "Results are cached per file. Gooze re-tests a file when its source or its test changes. No git needed.", command: "gooze run ./..." },
  { title: "Test only the diff", text: "On a pull request, mutate only the lines changed against a ref.", command: "gooze run --diff origin/main ./..." },
  { title: "Split across CI jobs", text: "Shard one run over several jobs, then merge the reports.", command: "gooze run -s INDEX/TOTAL ./..." },
  { title: "Share a baseline", text: "Push reports to any OCI registry; teammates and CI pull them.", command: "gooze report push ghcr.io/org/repo/gooze-reports:main" },
]

const steps = [
  { title: "Install", text: "With the Go toolchain.", command: "go install gooze.dev/pkg/gooze@latest" },
  { title: "Run", text: "From your module root. Each mutant runs only its own package's tests.", command: "gooze run ./..." },
  { title: "Read the survivors", text: "Per-file scores, each surviving mutant with its file and line, and the score.", command: "gooze report view" },
]

const wrap = "mx-auto w-full max-w-[1200px] px-4 sm:px-8"
const sectionTitle = "text-[44px] leading-[1.08] tracking-tight"
const card = "flex flex-col gap-3 rounded-lg border bg-muted p-6"
---
<BaseLayout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <NavHeader />
  <main>
    <section class={`${wrap} grid items-center gap-14 pt-28 pb-24 min-[1100px]:grid-cols-2`}>
      <div class="flex min-w-0 flex-col gap-6">
        <ClaudeCodeAnnouncement class="self-start" />
        <span class="gz-eyebrow">Mutation testing for Go</span>
        <h1 class="text-6xl tracking-tight md:text-8xl">Test your tests.</h1>
        <p class="gz-prose gz-prose--lead">Coverage shows which lines ran. Gooze changes your code one operator at a time, runs your tests, and shows every mutant they miss, with the file, line and diff.</p>
        <div class="flex flex-wrap gap-3"><Button size="lg" href="/docs/">Get started</Button><Button variant="outline" size="lg" href="https://github.com/gooze-dev/gooze" target="_blank" rel="noopener noreferrer">View on GitHub</Button></div>
        <CodeBlock code="go install gooze.dev/pkg/gooze@latest" lang="bash" class="max-w-[440px]" />
      </div>
      <div class="min-w-0">
        <TerminalWindow name="calc-report-view" tail={5} command="gooze report view" title="Terminal: gooze report view shows two survivors and a mutation score of 84.62%" class="my-0">Two boundary tests, <code>InRange(0, 0, 10)</code> and <code>InRange(10, 0, 10)</code>, kill both mutants and the score goes to <code>100.00%</code>.</TerminalWindow>
      </div>
    </section>

    <section class="border-y bg-muted">
      <div class={`${wrap} grid items-center gap-14 py-24 lg:grid-cols-2`}>
        <div class="flex flex-col gap-5">
          <span class="gz-eyebrow">How it works</span>
          <h2 class={sectionTitle}>Every <span class="font-mono text-accent">&lt;</span> could be a <span class="font-mono">≤</span>.</h2>
          <p class="gz-prose gz-prose--lead">Gooze makes one small change to your code, a mutant, and runs your tests. If a test fails, the mutant is killed. If every test still passes, it survived: your tests didn&apos;t notice a behavior change.</p>
          <p class="gz-prose">The mutation score is the share of mutants your tests kill. It measures what coverage can&apos;t.</p>
        </div>
        <MutationDiff line={firstSurvivor} />
      </div>
    </section>

    <section data-theme="dark" class="bg-brand-ink text-foreground">
      <div class={`${wrap} flex flex-col gap-8 py-24`}>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="flex max-w-[720px] flex-col gap-4">
            <span class="gz-eyebrow">Why now</span>
            <h2 class={sectionTitle}>Agents write tests fast. Gooze checks them.</h2>
            <p class="gz-prose gz-prose--lead">Coverage goes up either way: a test that runs a line counts even if it checks nothing. The Claude Code plugin shows Claude the mutation score and every surviving mutant right after it edits a file.</p>
          </div>
          <span class="gz-tag gz-tag--beta">Claude Code plugin · Beta</span>
        </div>
        <AgentLoop />
      </div>
    </section>

    <section class={`${wrap} flex flex-col gap-10 py-24`}>
      <div class="flex max-w-[720px] flex-col gap-4">
        <span class="gz-eyebrow">Built for CI</span>
        <h2 class={sectionTitle}>Stays fast as the codebase grows.</h2>
        <p class="gz-prose gz-prose--lead">Every claim here has a mechanism behind it, and a flag you can try.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {mechanisms.map((item) => (
          <div class={`${card} min-w-0`}><span class="text-[17px] font-semibold">{item.title}</span><p class="text-[15px] leading-[1.55]">{item.text}</p><CodeBlock code={item.command} lang="bash" class="mt-auto" /></div>
        ))}
      </div>
      <p class="gz-prose">Set a threshold and Gooze becomes a quality gate: below your score, it exits with code <code>3</code> and the job fails.</p>
    </section>

    <section class="border-y">
      <div class={`${wrap} py-10`}><WorksWith /></div>
    </section>

    <section class={`${wrap} flex flex-col gap-10 py-24`}>
      <div class="flex flex-col gap-4"><span class="gz-eyebrow">Get started</span><h2 class={sectionTitle}>Three commands.</h2></div>
      <div class="grid gap-4 lg:grid-cols-3">
        {steps.map((step, index) => (
          <div class={`${card} min-w-0`}>
            <div class="flex items-center gap-2.5"><span class="grid size-7 place-items-center rounded-full bg-highlight font-mono text-[13px] font-semibold text-highlight-foreground">{index + 1}</span><span class="text-[17px] font-semibold">{step.title}</span></div>
            <p class="text-[15px] leading-[1.55]">{step.text}</p>
            <CodeBlock code={step.command} lang="bash" class="mt-auto" />
          </div>
        ))}
      </div>
      <a href="/docs/quick-start/" class="self-start font-medium text-accent hover:text-foreground">Read the quick start →</a>
    </section>

    <section id="faq" class="scroll-mt-8 border-t bg-muted">
      <div class={`${wrap} grid gap-12 py-24 lg:grid-cols-[1fr_2fr]`}>
        <div class="flex flex-col gap-4">
          <span class="gz-eyebrow">FAQ</span>
          <h2 class={sectionTitle}>Questions</h2>
          <p class="gz-prose">Choosing a tool? See the <a href="/docs/comparison/" class="text-accent underline underline-offset-4 hover:text-foreground">comparison of Go mutation testing tools</a>.</p>
        </div>
        <FaqList faqs={faqs} />
      </div>
      <HeadingAnchors rootId="faq" />
    </section>
  </main>

  <footer class="border-t">
    <div class={`${wrap} flex flex-wrap items-center justify-between gap-4 py-10`}>
      <span class="flex flex-wrap items-center gap-2"><Lockup mark={false} class="text-xl" /><span class="ml-2 text-sm text-muted-foreground">Open source, MIT. Built by the Gooze team.</span></span>
      <span class="flex gap-5 text-sm"><a href="/docs/" class="text-accent hover:text-foreground">Documentation</a><a href="https://github.com/gooze-dev/gooze" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-foreground">GitHub</a><a href="/docs/comparison/" class="text-accent hover:text-foreground">Comparison</a></span>
    </div>
  </footer>
</BaseLayout>
