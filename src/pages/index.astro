---
import CodeBlock from "@/components/CodeBlock.astro"
import Lockup from "@/components/Lockup.astro"
import NavHeader from "@/components/NavHeader.astro"
import TerminalWindow from "@/components/TerminalWindow.astro"
import WorksWith from "@/components/WorksWith.astro"
import Button from "@/components/ui/Button.astro"
import ClaudeCodeAnnouncement from "@/components/ClaudeCodeAnnouncement.astro"
import FaqList from "@/components/FaqList.astro"
import HeadingAnchors from "@/components/HeadingAnchors.astro"
import Icon from "@/components/Icon.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import type { Metadata } from "@/lib/metadata"
import { faqPageJsonLd } from "@/lib/faq"
import { recordingText } from "@/lib/recording"

// Self-canonical for the homepage. The root layout no longer sets a default
// canonical (it would leak onto every other page).
const metadata: Metadata = {
  alternates: { canonical: "/" },
};

// Five questions, rendered on the page AND emitted as FAQPage JSON-LD from the
// same array. The rest are on the mutation testing page.
const faqs = [
  {
    q: "What is Gooze?",
    a: "Gooze is an open-source mutation testing tool for Go (Golang) that measures the quality of your test suite by injecting small, deliberate bugs (mutations) into your code and checking whether your tests catch them.",
  },
  {
    q: "Our coverage is high but bugs still reach production. How does Gooze help?",
    a: "High line coverage only proves your code was executed, not that your assertions check the result. Gooze injects deliberate faults into your code and checks that your tests fail. A survived mutant shows code your tests run but don't check. For example, tests for a range check can run every line without trying a value exactly on a bound, and Gooze reports `if n < lo {` -> `if n <= lo {` as survived.",
  },
  {
    q: "Mutation testing is slow. Will it block our CI/CD pipeline?",
    a: "It doesn't have to. Passing a Go coverage profile skips tests for uncovered lines, the incremental cache reuses results for unchanged files, and parallel workers and sharding split the remaining work.",
  },
  {
    q: "Does Gooze run the whole test suite for every mutant?",
    a: "No. Each mutant runs `go test` only for its own package, never the whole module. A run can also be as small as you need: the cache re-tests only files that changed, `--diff origin/main` mutates only the lines a pull request changes, and `--run '^InRange$'` mutates one function. That keeps runs short enough for AI coding agents to check every edit they make.",
  },
  {
    q: "Why use Gooze for Go mutation testing?",
    a: "Gooze is built for CI/CD. It has an incremental cache that re-tests only changed files, sharding across parallel CI runners, coverage-profile support that skips tests for uncovered lines, and OCI registry support to share baseline reports across teams.",
  },
];

const faqJsonLd = faqPageJsonLd(faqs);

// Real output only: the agents section quotes one line of the hook's real output
// and the score of the fixed run, both from recordings.
const hook = JSON.parse(recordingText("calc-hook-claude")) as { hookSpecificOutput: { additionalContext: string } }
const hookLine = hook.hookSpecificOutput.additionalContext.split("\n").find((line) => line.startsWith("calc.go:10:")) ?? ""
const [hookStart, hookOriginal, hookArrow, hookMutant] = hookLine.split("`")
const [hookWhere, hookRest] = hookStart.split(/(?<=:\d+:\d+: )/)
const fixedScore = recordingText("calc-fixed-score").match(/\d+\.\d+%/)?.[0]

const rows = [
  { title: "Re-test only what changed", text: "Results are cached per file. A file is re-tested when its source or its test changes.", flag: "gooze run ./..." },
  { title: "Test only the diff", text: "On a pull request, mutate only the lines changed against a ref.", flag: "--diff origin/main" },
  { title: "Split across CI jobs", text: "Shard one run over several jobs, then merge the reports.", flag: "-s 1/4" },
  { title: "Fail below a score", text: "The job exits with code 3 when the score drops under your threshold.", flag: "--threshold-total 80" },
]

const closingSteps = [
  { title: "Install", text: "With the Go toolchain.", command: "go install gooze.dev/pkg/gooze@latest" },
  { title: "Run", text: "Mutate every package and run its tests.", command: "gooze run ./..." },
  { title: "Read the report", text: "Survivors with file, line and diff.", command: "gooze report view" },
]
---
<BaseLayout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <NavHeader />
  <main class="gz-l">
    <section class="gz-l__sec gz-l__sec--center gz-l__hero">
      <div class="gz-l__in">
        <p class="gz-l__label">Mutation testing for Go</p>
        <h1 class="gz-l__h1">Test your tests.</h1>
        <p class="gz-l__lead">Coverage shows which lines ran. Gooze injects small, deliberate bugs into your code, one at a time, and shows every one your tests miss, with the file, line and diff.</p>
        <CodeBlock code="go install gooze.dev/pkg/gooze@latest" lang="bash" class="max-w-[560px]" />
        <div class="gz-l__actions"><Button size="lg" href="/docs/">Get started</Button><a href="https://github.com/gooze-dev/gooze" target="_blank" rel="noopener noreferrer" class="gz-l__link">View on GitHub <Icon name="arrow-right" class="size-3.5" aria-hidden="true" /></a></div>
      </div>
    </section>

    <section class="gz-l__sec gz-l__sec--subtle">
      <div class="gz-l__in gz-l__split">
        <div class="gz-l__in">
          <p class="gz-l__label">How it works</p>
          <h2 class="gz-l__h2">Every <span class="lt">&lt;</span> could be a ≤.</h2>
          <p class="gz-l__p">Gooze changes <code>&lt;</code> to <code>&lt;=</code> and runs your tests. If a test fails, the mutant is <code>killed</code>. If every test still passes, it <code>survived</code>: your tests run that line but don&apos;t check it.</p>
        </div>
        <TerminalWindow name="calc-report-view" tail={5} command="gooze report view" title="Terminal: gooze report view shows two survivors and a mutation score of 84.62%" class="my-0 min-w-0">Two boundary tests kill both mutants. The score goes to <code>{fixedScore}</code>.</TerminalWindow>
      </div>
    </section>

    <section data-theme="dark" class="gz-l__sec gz-l__band">
      <div class="gz-l__in">
        <p class="gz-l__label">Why now</p>
        <h2 class="gz-l__h2">Agents write tests fast. Gooze checks them.</h2>
        <p class="gz-l__p">A test that runs a line counts for coverage even if it checks nothing. The Claude Code plugin shows Claude every surviving mutant right after it edits a file.</p>
        <ol class="gz-l__steps">
          <li><span>You ask: &ldquo;Kill the surviving mutants in <code>InRange</code> only.&rdquo;</span></li>
          <li><span>After each edit, Claude sees the survivors.<span class="out">{hookWhere}<span class="w">warning:</span>{hookRest.replace("warning:", "")}`<span class="o">{hookOriginal}</span>`{hookArrow}`<span class="m">{hookMutant}</span>`</span></span></li>
          <li><span>Two boundary tests later:<span class="gz-l__score">{fixedScore}</span></span></li>
        </ol>
        <ClaudeCodeAnnouncement class="self-start lg:self-center" />
      </div>
    </section>

    <section class="gz-l__sec">
      <div class="gz-l__in">
        <p class="gz-l__label">Built for CI</p>
        <h2 class="gz-l__h2">Stays fast as the codebase grows.</h2>
        <div class="gz-l__rows">
          {rows.map((row) => <div class="gz-l__row"><h3>{row.title}</h3><p>{row.text}</p><code>{row.flag}</code></div>)}
        </div>
        <WorksWith />
      </div>
    </section>

    <section class="gz-l__sec gz-l__sec--subtle gz-l__sec--center">
      <div class="gz-l__in">
        <div class="gz-l__cta">
          <p class="gz-l__label">Get started</p>
          <h2 class="gz-l__h2">Run it on your module.</h2>
          <p class="gz-l__p">Three commands from your module root. The report lists every mutant your tests miss, with the file, line and diff.</p>
          <ol class="gz-l__cta-steps">
            {closingSteps.map((step) => (
              <li><span class="t">{step.title}</span><p class="d">{step.text}</p><CodeBlock code={step.command} lang="bash" class="mt-auto" /></li>
            ))}
          </ol>
          <div class="gz-l__actions"><Button size="lg" href="/docs/quick-start/">Read the quick start</Button><a href="https://github.com/gooze-dev/gooze" target="_blank" rel="noopener noreferrer" class="gz-l__link">View on GitHub <Icon name="arrow-right" class="size-3.5" aria-hidden="true" /></a></div>
        </div>
      </div>
    </section>

    <section id="faq" class="gz-l__sec scroll-mt-8">
      <div class="gz-l__in gz-l__in--narrow">
        <h2 class="gz-l__h2">Questions</h2>
        <FaqList faqs={faqs} />
        <a href="/docs/mutation-testing/#faq" class="gz-l__link gz-l__more self-start">More questions <Icon name="arrow-right" class="size-3.5" aria-hidden="true" /></a>
      </div>
      <HeadingAnchors rootId="faq" />
    </section>
  </main>

  <footer class="border-t">
    <div class="mx-auto flex w-full max-w-[1184px] flex-wrap items-center justify-between gap-4 px-4 py-6 md:px-8">
      <span class="flex flex-wrap items-center gap-2"><Lockup mark={false} class="text-xl" /><span class="text-sm text-muted-foreground">Open source, MIT. Built by the Gooze team.</span></span>
      <span class="flex gap-5 text-sm"><a href="/docs/" class="text-accent hover:text-foreground">Documentation</a><a href="https://github.com/gooze-dev/gooze" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-foreground">GitHub</a><a href="/docs/comparison/" class="text-accent hover:text-foreground">Comparison</a></span>
    </div>
  </footer>
</BaseLayout>
