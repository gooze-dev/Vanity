---
import CodeBlock from "@/components/CodeBlock.astro"
import GoozeLogo from "@/components/GoozeLogo.astro"
import GoozePrimaryCtaButton from "@/components/GoozePrimaryCtaButton.astro"
import DocsLayout from "@/layouts/DocsLayout.astro"
import { docsMetadata } from "@/lib/docs-meta"
import { docsSections, getSectionLanding } from "@/lib/docs-pages"
import { withSlash } from "@/lib/links"

// Section links come from lib/docs-pages.ts, the same source as the sidebar.
// "Get started" is skipped: its landing page is this page.
const sectionLinks = docsSections.flatMap((section) => {
  const landing = getSectionLanding(section)
  return landing && landing.href !== "/docs" ? [{ section, href: landing.href }] : []
})


const metadata = docsMetadata("/docs")
---
<DocsLayout metadata={metadata}>
    <section>
      <h1 class="mt-0 text-4xl font-bold tracking-tight mb-4"><GoozeLogo /></h1>
      <p class="text-lg text-muted-foreground mb-10">Your tests pass, but would they fail if the code were wrong? Gooze is mutation testing for
        Go: it makes small changes to your source, runs your tests against each one and shows you
        the changes they miss. The name is Go + ooze, after the{" "}<a href="https://turtlepedia.fandom.com/wiki/Mutagen" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">mutagen</a>{" "}that mutates the turtles in Teenage Mutant Ninja Turtles.</p>
      <div class="rounded-lg border bg-card p-5 mb-12">
        <h2>New to mutation testing?</h2>
        <p>Read{" "}<a href="/docs/mutation-testing/" class="underline underline-offset-4">What is mutation testing?</a>{" "}first, then come back for your first run.</p>
      </div>
      <div id="get-started">
        <h2>Get started</h2>
        <p>Install Gooze, run it from your module root, then read the report:</p>
        <CodeBlock lang="bash" code={`go install gooze.dev/pkg/gooze@latest
gooze run ./...
gooze report view`} />
        <p class="text-sm text-muted-foreground mb-4">The Quick start walks through a first run on a small package, from the surviving mutants
          to the tests that kill them, plus faster runs with <code>--coverage-profile</code> and
          parallel workers.</p><GoozePrimaryCtaButton href="/docs/quick-start/">Open Quick start</GoozePrimaryCtaButton></div>
      <div id="sections" class="mt-12">
        <h2>Sections</h2>
        <p>{sectionLinks.map((link, i) => (
            <span>{i > 0 && " · "}<a href={withSlash(link.href)} class="underline underline-offset-4">{link.section}</a></span>
          ))}</p>
      </div>
    </section>
</DocsLayout>
