---
import DocsRedirect from "@/components/DocsRedirect.astro"
import DocsLayout from "@/layouts/DocsLayout.astro"
import { redirectMetadata } from "@/lib/metadata"

const TITLE = "UI modes"

const TO = "/docs/usage/ui-modes/"


const metadata = redirectMetadata(TITLE, TO)
---
<DocsLayout metadata={metadata}>
    <DocsRedirect title={TITLE} to={TO} />
</DocsLayout>
