---
import DocsLayout from "@/layouts/DocsLayout.astro"
import Icon from "@/components/Icon.astro"
import PartnerLogo from "@/components/PartnerLogo.astro"
import { areas, byMilestone, counts, laterThemes, nextCards, percent, released, shippedVersion, type RoadmapItem } from "@/data/roadmap"
import { docsMetadata } from "@/lib/docs-meta"
import { withCode } from "@/lib/faq"
import { slugify } from "@/lib/heading-id"
import { withSlash } from "@/lib/links"

const features = (count: number) => `${count} ${count === 1 ? "feature" : "features"}`

const percentOf = (count: number) => `${(count / counts.total) * 100}%`

const shippedAreas = Object.entries(areas)
  .map(([id, title]) => ({ id, title, items: byMilestone("shipped").filter((item) => item.area === id) }))
  .filter((area) => area.items.length > 0)

const cards = nextCards
  .map((card) => ({ ...card, items: byMilestone("next").filter((item) => item.card === card.id) }))
  .filter((card) => card.items.length > 0)

const themes = Object.entries(laterThemes)
  .map(([id, title]) => ({ id, title, items: byMilestone("later").filter((item) => item.theme === id) }))
  .filter((theme) => theme.items.length > 0)

// Anchors of the old page: an item's explicit id, and the slug of its name that
// the copy-link button gave its heading.
const itemId = (item: RoadmapItem) => slugify(item.name)

const aliasId = (item: RoadmapItem) => (item.anchor && item.anchor !== itemId(item) ? item.anchor : undefined)

const description = (item: RoadmapItem) => withCode(item.description ?? "")

const milestoneClass = "relative flex flex-col gap-3 pl-11"
const nodeClass = "absolute left-0 top-0.5 grid size-7 place-items-center rounded-full border-2 bg-background"
const headClass = "flex flex-wrap items-baseline gap-3"
const titleClass = "font-display text-2xl font-bold leading-tight text-foreground max-sm:text-xl"
const countClass = "rounded-full border px-2 py-1 font-mono text-xs leading-none text-muted-foreground"
const descClass = "max-w-[62ch] text-[0.9375rem] text-muted-foreground"
const cardClass = "flex flex-col gap-2 rounded-lg border bg-background p-4"
const cardTitleClass = "flex items-center gap-2 text-base font-semibold leading-snug text-foreground"
const cardTextClass = "text-sm leading-normal text-muted-foreground"
const linkClass = "font-medium text-accent underline-offset-4 hover:text-foreground hover:underline"

const metadata = docsMetadata("/docs/roadmap")
---
<DocsLayout metadata={metadata}>
    <section>
      <h1 class="mt-0 text-4xl font-bold tracking-tight mb-4">Roadmap</h1>
      <p class="gz-prose gz-prose--lead mb-8">Missing a feature you need? Check whether it has shipped, whether it&apos;s coming
        next, and what to use in the meantime.</p>

      <div class="not-typeset flex flex-col gap-3 rounded-lg border bg-card p-4">
        <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <span class="font-display text-[2rem] font-bold leading-none text-foreground">{percent}%</span>{" "}
          <span class="text-sm font-medium text-muted-foreground">{released} of {counts.total} features shipped, {counts.beta} of them in beta</span>
        </p>
        <div class="flex h-2 overflow-hidden rounded-full bg-border" role="img" aria-label={`${counts.shipped} shipped, ${counts.beta} in beta, ${counts.next + counts.later} planned`}>
          <span class="bg-highlight" style={{ width: percentOf(counts.shipped) }}></span>
          <span class="bg-accent" style={{ width: percentOf(counts.beta) }}></span>
        </div>
        <ul class="flex flex-wrap gap-x-4 gap-y-2 text-[0.8125rem] text-muted-foreground">
          <li class="inline-flex items-center gap-1.5"><span class="gz-tag gz-tag--available">Shipped</span>{" "}{counts.shipped}</li>
          <li class="inline-flex items-center gap-1.5"><span class="gz-tag gz-tag--beta">Beta</span>{" "}{counts.beta}</li>
          <li class="inline-flex items-center gap-1.5"><span class="gz-tag border-accent text-accent">Next</span>{" "}{counts.next}</li>
          <li class="inline-flex items-center gap-1.5"><span class="gz-tag gz-tag--soon">Later</span>{" "}{counts.later}</li>
        </ul>
        <p class="text-[0.8125rem] text-muted-foreground">No dates. Next is being worked on now; Later is planned, in no fixed order.</p>
      </div>

      <ol class="not-typeset relative mt-8 flex flex-col gap-10 before:absolute before:bottom-3.5 before:left-[13px] before:top-3.5 before:w-0.5 before:bg-border [&_code]:rounded [&_code]:bg-muted [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.8125rem] [&_code]:text-foreground">
        <li class:list={[milestoneClass, "before:absolute before:-bottom-10 before:left-[13px] before:top-3.5 before:w-0.5 before:bg-highlight"]}>
          <span class:list={[nodeClass, "border-highlight bg-highlight text-highlight-foreground"]} aria-hidden="true"><Icon name="check" class="size-3.5" stroke-width="3" /></span>
          <div class={headClass}>
            <h2 id="shipped" class={titleClass}>Shipped</h2>
            <span class={countClass}>{shippedVersion} · {features(counts.shipped)}</span>
          </div>
          <p class={descClass}>Everything here is in the current release.</p>
          <div class="flex flex-col border-t">{shippedAreas.map((area, index) => (
            <details id={area.id} data-open-from-md={index === 0 || undefined} class="group border-b py-2.5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-[0.9375rem] font-semibold text-foreground [&::-webkit-details-marker]:hidden">
                <span class="flex items-center gap-1.5"><Icon name="chevron-right" class="size-4 text-muted-foreground transition-transform group-open:rotate-90" aria-hidden="true" />{area.title}</span>
                {" "}<span class="font-mono text-[0.8125rem] font-medium text-muted-foreground">{area.items.length}</span>
              </summary>
              <ul class="mt-3 flex flex-col gap-3 sm:gap-2">{area.items.map((item) => (
                <li id={itemId(item)} class="grid items-baseline gap-1 sm:grid-cols-[11.5rem_minmax(0,1fr)] sm:gap-3">
                  {aliasId(item) && <span id={aliasId(item)} class="absolute"></span>}
                  {item.docs ? (
                    <a href={withSlash(item.docs)} class="inline-flex w-fit items-center gap-1.5 rounded-full border bg-card px-2.5 py-1 text-[0.8125rem] leading-snug text-foreground hover:border-input hover:bg-muted"><Icon name="check" class="size-3 shrink-0 text-muted-foreground" aria-hidden="true" />{item.name}</a>
                  ) : (
                    <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-dashed px-2.5 py-1 text-[0.8125rem] leading-snug text-foreground"><Icon name="check" class="size-3 shrink-0 text-muted-foreground" aria-hidden="true" />{item.name}</span>
                  )}
                  <span class="sr-only">: </span>
                  <span class="block text-sm leading-normal text-muted-foreground" set:html={description(item)} />
                </li>
              ))}</ul>
            </details>
          ))}</div>
          {/* Every area is closed in the HTML, so phones never see one open. This runs
              before the page below it is parsed, so nothing moves on a wide screen. A
              client navigation does the same in BaseLayout, before the swap. */}
          <script is:inline>
            if (matchMedia("(min-width: 768px)").matches) {
              document.querySelectorAll("details[data-open-from-md]").forEach(function (area) {
                area.open = true
              })
            }
          </script>
        </li>

        <li class={milestoneClass}>
          <span class:list={[nodeClass, "border-foreground bg-[linear-gradient(90deg,var(--fg)_50%,var(--bg)_50%)]"]} aria-hidden="true"></span>
          <div class={headClass}>
            <h2 id="beta" class={titleClass}>Beta</h2>
            <span class={countClass}>{features(counts.beta)}</span>
          </div>
          <div class="grid gap-3 md:grid-cols-2">{byMilestone("beta").map((item) => (
            <div id={itemId(item)} class={cardClass}>
              <h3 class={cardTitleClass}><PartnerLogo name="claude" />{item.name}</h3>
              <p class={cardTextClass} set:html={description(item)} />
              {item.docs && <a href={withSlash(item.docs)} class="mt-auto inline-flex w-fit items-center gap-1 text-sm font-medium text-accent hover:text-foreground">Docs<Icon name="arrow-right" class="size-3.5" aria-hidden="true" /></a>}
            </div>
          ))}</div>
        </li>

        <li class={milestoneClass}>
          <span class:list={[nodeClass, "border-accent after:size-2.5 after:rounded-full after:bg-accent after:content-['']"]} aria-hidden="true"></span>
          <span id="limitations" class="absolute"></span>
          <div class={headClass}>
            <h2 id="next" class={titleClass}>Next</h2>
            <span class={countClass}>{features(counts.next)}</span>
          </div>
          <p class={descClass}>Being worked on now, with what to use until each one lands.</p>
          <div class="grid gap-3 md:grid-cols-2">{cards.map((card) => {
            const until = card.items.find((item) => item.until)?.until
            return (
              <div id={card.id} class={cardClass}>
                <h3 class={cardTitleClass}>{card.title}</h3>
                {/* Each feature keeps its old anchor. */}
                {card.items.filter((item) => itemId(item) !== card.id).map((item) => <span id={itemId(item)} class="absolute"></span>)}
                <p class={cardTextClass} set:html={withCode(card.detail)} />
                {until && <p class="mt-auto rounded-md bg-muted px-2.5 py-2 text-[0.8125rem] leading-snug text-foreground"><b class="mr-1 font-semibold text-muted-foreground">Until then:</b>{" "}use{" "}<a href={withSlash(until.href)} class={linkClass}>{until.text}</a>.</p>}
              </div>
            )
          })}</div>
        </li>

        <li class={milestoneClass}>
          <span class:list={[nodeClass, "border-dashed border-input"]} aria-hidden="true"></span>
          <div class={headClass}>
            <h2 id="later" class={titleClass}>Later</h2>
            <span class={countClass}>{features(counts.later)}</span>
          </div>
          <p class={descClass}>Planned, grouped by theme. The order is not a commitment.</p>
          <div class="grid gap-x-8 gap-y-6 md:grid-cols-2">{themes.map((theme) => (
            <div>
              <h3 id={`later-${theme.id}`} class="mb-2 text-xs font-medium uppercase tracking-[0.06em] text-muted-foreground">{theme.title}</h3>
              <ul class="flex flex-col gap-2.5">{theme.items.map((item) => (
                <li id={itemId(item)} class="text-sm leading-normal text-muted-foreground"><b class="font-semibold text-foreground" set:html={`${withCode(item.name)}:`} />{" "}<Fragment set:html={description(item)} />{item.issue && <Fragment>{" "}<a href={`https://github.com/gooze-dev/gooze/issues/${item.issue}`} class={linkClass}>Issue #{item.issue}</a></Fragment>}</li>
              ))}</ul>
            </div>
          ))}</div>
        </li>
      </ol>

      <p class="mt-8 text-sm text-muted-foreground">How this compares with other tools:{" "}<a href="/docs/comparison/">Gooze vs other Go mutation testing tools</a>.</p>
    </section>
</DocsLayout>

<script>
  // Opens the area of a shipped feature when the URL points at it.
  function openTarget() {
    const id = decodeURIComponent(window.location.hash.slice(1))
    const details = id ? document.getElementById(id)?.closest("details") : null
    if (details && !details.open) {
      details.open = true
      document.getElementById(id)?.scrollIntoView({ block: "start" })
    }
  }

  document.addEventListener("astro:page-load", openTarget)
  window.addEventListener("hashchange", openTarget)
</script>
