---
import DocsBreadcrumb from "@/components/DocsBreadcrumb.astro"
import DocsPager from "@/components/DocsPager.astro"
import DocsSearch from "@/components/DocsSearch.astro"
import DocsSidebar from "@/components/DocsSidebar.astro"
import DocsStructuredData from "@/components/DocsStructuredData.astro"
import DocsToc from "@/components/DocsToc.astro"
import GoozeMark from "@/components/GoozeMark.astro"
import HeadingAnchors from "@/components/HeadingAnchors.astro"
import Icon from "@/components/Icon.astro"
import ThemeToggle from "@/components/ThemeToggle.astro"
import Button from "@/components/ui/Button.astro"
import Separator from "@/components/ui/Separator.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import type { Metadata } from "@/lib/metadata"

// wide: the page has a matrix that takes the full width, with the list of
// sections above it instead of beside it.
const { metadata, wide = false } = Astro.props as { metadata?: Metadata; wide?: boolean }
---
<BaseLayout metadata={metadata}>
  <div class="gooze-docs">
    <DocsStructuredData />
    <div data-slot="sidebar-wrapper" style="--sidebar-width:13.75rem;--sidebar-width-icon:3rem" class="group/sidebar-wrapper flex min-h-svh w-full has-data-[variant=inset]:bg-sidebar">
      <DocsSidebar />
      <main data-slot="sidebar-inset" class="relative flex w-full min-w-0 flex-1 flex-col bg-background md:peer-data-[variant=inset]:m-2 md:peer-data-[variant=inset]:ml-0 md:peer-data-[variant=inset]:rounded-lg md:peer-data-[variant=inset]:peer-data-[state=collapsed]:ml-2">
        <header class="sticky top-0 z-30 flex h-16 shrink-0 items-center gap-2 border-b bg-background/90 backdrop-blur supports-[backdrop-filter]:bg-background/70 transition-[width,height] ease-linear group-has-data-[collapsible=icon]/sidebar-wrapper:h-12">
          <div class="flex min-w-0 flex-1 items-center gap-2 px-4">
            <a href="/" aria-label="Gooze home" class="flex shrink-0 lg:hidden"><GoozeMark class="size-6!" /></a>
            <Button data-sidebar="trigger" data-slot="sidebar-trigger" data-sidebar-toggle variant="ghost" size="icon-sm" type="button" class="-ml-1 text-muted-foreground"><Icon name="panel-left" /><span class="sr-only">Toggle Sidebar</span></Button>
            <Separator orientation="vertical" class="mr-2 data-[orientation=vertical]:h-4 max-[479px]:hidden" />
            <DocsBreadcrumb />
          </div>
          <div class="flex items-center gap-2 pr-4">
            <DocsSearch />
            <ThemeToggle />
          </div>
        </header>
        <div class="flex flex-1 flex-col gap-4 p-4 pt-6">
          <div class:list={["mx-auto flex w-full gap-10", wide ? "max-w-[1120px]" : "max-w-[760px] xl:max-w-[1008px]"]}>
            <div class="min-w-0 flex-1 space-y-8">
              <DocsToc collapsible open={wide} class={wide ? undefined : "xl:hidden"} />
              <article id="docs-content" data-wide={wide || undefined} class="typeset typeset-docs"><slot /></article>
              <HeadingAnchors />
              <DocsPager />
            </div>
            {!wide && <aside class="hidden w-52 shrink-0 xl:block">
              <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto">
                <DocsToc />
              </div>
            </aside>}
          </div>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>
