---
import iconLight from "@/assets/logo/gooze-icon-light.svg"
import colorMark from "@/assets/logo/gooze-mark.svg"
import { cn } from "@/lib/utils"

// The mark alone: colour on dark, the Gopher Blue tile on light.
const { class: className } = Astro.props
const ColorMark = colorMark
const IconLight = iconLight
---
<ColorMark class={cn("hidden dark:block", className)} aria-hidden="true" /><IconLight class={cn("dark:hidden", className)} aria-hidden="true" />
