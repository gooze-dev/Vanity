---
import iconDark from "@/assets/logo/gooze-icon-dark.svg"
import colorMark from "@/assets/logo/gooze-mark.svg"
import { cn } from "@/lib/utils"

// The mark alone: colour on dark, the colour mark on its ink tile on light.
const { class: className } = Astro.props
const ColorMark = colorMark
const IconDark = iconDark
---
<ColorMark class={cn("hidden dark:block", className)} aria-hidden="true" /><IconDark class={cn("dark:hidden", className)} aria-hidden="true" />
