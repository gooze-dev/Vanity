---
import Icon from "@/components/Icon.astro"

const kbd = "pointer-events-none inline-flex h-5.5 w-fit min-w-5.5 items-center justify-center gap-1 rounded-lg bg-muted px-1.5 font-sans text-xs font-medium text-muted-foreground select-none"
---
<button data-search-open type="button" aria-label="Search documentation" class="inline-flex h-9 w-9 shrink-0 items-center justify-center gap-2 rounded-md border border-input bg-transparent px-0 text-sm text-muted-foreground shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground lg:w-56 lg:justify-start lg:px-3">
  <Icon name="search" class="h-4 w-4 shrink-0" />
  <span class="hidden flex-1 truncate whitespace-nowrap text-left lg:block">Search</span>
  <kbd data-slot="kbd-group" class="pointer-events-none hidden items-center gap-1 lg:inline-flex"><kbd data-slot="kbd" data-search-mod class={kbd}>⌘</kbd><kbd data-slot="kbd" class={kbd}>K</kbd></kbd>
</button>

<dialog data-search-dialog aria-label="Search documentation" class="m-0 size-full max-h-none max-w-none overflow-hidden bg-transparent backdrop:bg-transparent">
  <div data-search-overlay data-state="open" class="fixed inset-0 z-50 bg-black/50 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0"></div>
  <div data-search-content data-state="open" class="fixed left-1/2 top-[15vh] z-50 w-[calc(100%-2rem)] max-w-xl -translate-x-1/2 overflow-hidden rounded-xl border bg-popover text-popover-foreground shadow-lg data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0">
  <div class="flex items-center gap-2 border-b px-4">
    <Icon name="search" class="h-4 w-4 shrink-0 text-muted-foreground" />
    <input data-search-input placeholder="Search docs and flags…" aria-label="Search the documentation" class="h-12 w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground" />
  </div>
  <ul data-search-results class="max-h-80 overflow-y-auto p-2"></ul>
  </div>
  <template data-search-empty>
    <li>
      <div data-slot="empty" class="flex w-full min-w-0 flex-1 flex-col items-center justify-center gap-4 rounded-2xl border-dashed p-12 text-center text-balance py-8">
        <div data-slot="empty-header" class="flex max-w-sm flex-col items-center gap-2">
          <div data-slot="empty-icon" data-variant="icon" class="mb-2 flex size-10 shrink-0 items-center justify-center rounded-xl bg-muted text-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-5"><Icon name="search-x" /></div>
          <div data-slot="empty-title" class="text-lg font-medium tracking-tight">No results for “<span data-search-query></span>”</div>
          <div data-slot="empty-description" class="text-sm/relaxed text-muted-foreground">Try a command (<code>report merge</code>), a flag (<code>--shard</code>), or a topic (<code>cache</code>).</div>
        </div>
      </div>
    </li>
  </template>
</dialog>

<script>
  import { navigate } from "astro:transitions/client"
  import { docsFlags, docsPages, type DocsFlag, type DocsPage } from "@/lib/docs-pages"
  import { withSlash } from "@/lib/links"
  import { cn } from "@/lib/utils"

  // A unified search result: either a documentation page or a CLI flag. The
  // site is static, so there is no search server: entries are ranked by
  // substring matches in the browser.
  type SearchEntry = { kind: "page" | "flag"; href: string; title: string; meta: string; description: string }

  function pageEntry(page: DocsPage): SearchEntry {
    return { kind: "page", href: page.href, title: page.title, meta: page.section, description: page.description }
  }

  function flagEntry(flag: DocsFlag): SearchEntry {
    return {
      kind: "flag",
      href: flag.href,
      title: flag.alias ? `${flag.flag}, ${flag.alias}` : flag.flag,
      meta: flag.command,
      description: flag.description,
    }
  }

  const allEntries = [...docsPages.map(pageEntry), ...docsFlags.map(flagEntry)]

  function scorePage(page: DocsPage, q: string): number {
    const title = page.title.toLowerCase()
    if (title === q) return 100
    if (title.startsWith(q)) return 80
    if (title.includes(q)) return 60
    if (page.keywords.some((k) => k.toLowerCase().includes(q))) return 40
    if (page.section.toLowerCase().includes(q)) return 25
    if (page.description.toLowerCase().includes(q)) return 20
    return 0
  }

  function scoreFlag(flag: DocsFlag, q: string): number {
    const f = flag.flag.toLowerCase()
    const alias = flag.alias?.toLowerCase() ?? ""
    // Make flags easy to find whether or not the user types the leading dashes.
    const bare = q.replace(/^-+/, "")
    if (f === q || alias === q) return 100
    if (f.replace(/^-+/, "").startsWith(bare) && bare.length > 0) return 85
    if (f.includes(q) || (alias && alias === q)) return 65
    if (flag.command.toLowerCase().includes(q)) return 30
    if (flag.description.toLowerCase().includes(q)) return 20
    return 0
  }

  function search(query: string): SearchEntry[] {
    const trimmed = query.trim().toLowerCase()
    if (!trimmed) return allEntries
    const pages = docsPages
      .map((page) => ({ entry: pageEntry(page), score: scorePage(page, trimmed) }))
      .filter(({ score }) => score > 0)
    const flags = docsFlags
      .map((flag) => ({ entry: flagEntry(flag), score: scoreFlag(flag, trimmed) }))
      .filter(({ score }) => score > 0)
    return [...pages, ...flags].sort((a, b) => b.score - a.score).map(({ entry }) => entry)
  }

  // Re-read on every page: the header is replaced by client navigation.
  let dialog: HTMLDialogElement | null
  let input: HTMLInputElement | null
  let list: HTMLElement | null
  let empty: HTMLTemplateElement | null
  const base = import.meta.env.BASE_URL.replace(/\/$/, "")

  let results = allEntries
  let active = 0

  function linkClass(index: number) {
    return cn("block rounded-md px-3 py-2 transition-colors", index === active ? "bg-accent text-accent-foreground" : "hover:bg-accent/50")
  }

  function entryHref(entry: SearchEntry) {
    return `${base}${withSlash(entry.href)}`
  }

  function span(className: string, text: string) {
    const element = document.createElement("span")
    element.className = className
    element.textContent = text
    return element
  }

  function renderEntry(entry: SearchEntry, index: number) {
    const link = document.createElement("a")
    link.href = entryHref(entry)
    link.className = linkClass(index)
    link.addEventListener("click", close)
    link.addEventListener("mouseenter", () => setActive(index))

    const row = document.createElement("div")
    row.className = "flex items-center justify-between gap-2"
    const meta = span("flex shrink-0 items-center gap-1.5 text-[10px] uppercase tracking-wide text-muted-foreground", "")
    if (entry.kind === "flag") {
      meta.append(span("rounded bg-[color:var(--gooze-teal)]/15 px-1 py-px font-medium text-[color:var(--gooze-teal)]", "flag"))
    }
    meta.append(entry.meta)
    row.append(span(cn("text-sm font-medium", entry.kind === "flag" && "font-mono"), entry.title), meta)

    const description = document.createElement("p")
    description.className = "mt-0.5 line-clamp-1 text-xs text-muted-foreground"
    description.textContent = entry.description

    link.append(row, description)
    const item = document.createElement("li")
    item.append(link)
    return item
  }

  function setActive(index: number) {
    active = index
    list?.querySelectorAll("a").forEach((link, i) => (link.className = linkClass(i)))
  }

  function render() {
    if (!list || !input) return
    results = search(input.value)
    active = 0
    if (results.length === 0 && empty) {
      const node = empty.content.cloneNode(true) as DocumentFragment
      const query = node.querySelector("[data-search-query]")
      if (query) query.textContent = input.value
      list.replaceChildren(node)
    } else {
      list.replaceChildren(...results.map(renderEntry))
    }
  }

  function setState(state: "open" | "closed") {
    for (const part of dialog?.querySelectorAll<HTMLElement>("[data-state]") ?? []) part.dataset.state = state
  }

  function open() {
    if (!dialog || !input) return
    input.value = ""
    render()
    setState("open")
    dialog.showModal()
    input.focus()
  }

  // The dialog leaves the top layer once its closing animation ends.
  async function close() {
    const closing = dialog
    if (!closing?.open) return
    setState("closed")
    await Promise.allSettled(closing.getAnimations({ subtree: true }).map((animation) => animation.finished))
    if (closing.querySelector('[data-search-content][data-state="closed"]')) closing.close()
  }

  document.addEventListener("astro:page-load", () => {
    dialog = document.querySelector("[data-search-dialog]")
    input = document.querySelector("[data-search-input]")
    list = document.querySelector("[data-search-results]")
    empty = document.querySelector("[data-search-empty]")

    // A page-load without a swap (same page) must not bind these twice.
    if (!dialog || dialog.dataset.bound) return
    dialog.dataset.bound = "true"

    document.querySelector("[data-search-open]")?.addEventListener("click", open)
    input?.addEventListener("input", render)

    input?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault()
        setActive(Math.min(active + 1, results.length - 1))
      } else if (event.key === "ArrowUp") {
        event.preventDefault()
        setActive(Math.max(active - 1, 0))
      } else if (event.key === "Enter") {
        event.preventDefault()
        const entry = results[active]
        if (entry) {
          close()
          navigate(entryHref(entry))
        }
      }
    })

    // Escape and a click on the overlay close it with the same animation.
    dialog?.addEventListener("cancel", (event) => {
      event.preventDefault()
      close()
    })
    dialog?.querySelector("[data-search-overlay]")?.addEventListener("click", close)

    const nav = navigator as Navigator & { userAgentData?: { platform?: string } }
    if (!/mac/i.test(nav.userAgentData?.platform ?? nav.platform ?? "")) {
      const mod = document.querySelector("[data-search-mod]")
      if (mod) mod.textContent = "Ctrl"
    }
  })

  window.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k" && dialog) {
      event.preventDefault()
      if (dialog.open) close()
      else open()
    }
  })
</script>
