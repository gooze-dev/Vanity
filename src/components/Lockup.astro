---
import colorMark from "@/assets/logo/gooze-mark.svg"
import lightMark from "@/assets/logo/gooze-mark-light.svg"
import { cn } from "@/lib/utils"

// The Lockup: the bare mark in both themes, with an ink bar on light. mark={false}
// leaves the wordmark alone, for a place that shows the mark separately. A slot
// continues the wordmark (goozels).
const { class: className, mark = true } = Astro.props
const ColorMark = colorMark
const LightMark = lightMark
const ls = Astro.slots.has("default")
---
{mark ? (
  <span class={cn("gz-lockup", className)}><ColorMark class="hidden dark:block" aria-hidden="true" /><LightMark class="dark:hidden" aria-hidden="true" /><span class:list={["gz-wordmark", ls && "gz-wordmark--ls"]}><span class="go">Go</span><span class="oze">oze<slot /></span></span></span>
) : (
  <span class={cn("gz-wordmark", ls && "gz-wordmark--ls", className)}><span class="go">Go</span><span class="oze">oze<slot /></span></span>
)}
