---
import Icon from "@/components/Icon.astro"

const { shipped, beta } = Astro.props
---
{beta ? (
  <span class="gz-tag gz-tag--beta"><Icon name="flask-conical" class="size-3" aria-hidden="true" />Beta</span>
) : shipped ? (
  <span class="gz-tag gz-tag--available"><Icon name="circle-check" class="size-3" aria-hidden="true" />Shipped</span>
) : (
  <span class="gz-tag gz-tag--planned"><Icon name="circle-dashed" class="size-3" aria-hidden="true" />Planned</span>
)}
