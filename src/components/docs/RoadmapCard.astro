---
import Icon from "@/components/Icon.astro"
import RoadmapStatus from "@/components/docs/RoadmapStatus.astro"
import { withCode } from "@/lib/faq"
import { withSlash } from "@/lib/links"

const { item } = Astro.props
---
<li id={item.id} class={item.shipped ? "flex flex-col gap-2 rounded-xl border bg-card p-4" : "flex flex-col gap-2 rounded-xl border border-dashed border-[color:var(--gooze-teal)]/40 bg-[color:var(--gooze-teal)]/5 p-4"}>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold leading-snug text-foreground" set:html={withCode(item.title)} />
    <RoadmapStatus shipped={item.shipped} beta={item.beta} />
  </div>
  <p class="text-sm leading-relaxed text-muted-foreground [&_code]:rounded [&_code]:bg-muted [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.8125rem] [&_code]:text-foreground">{typeof item.detail === "string" ? item.detail : <Fragment set:html={item.detail.html} />}</p>
  {item.issue && <a href={`https://github.com/gooze-dev/gooze/issues/${item.issue}`} class="mt-auto inline-flex w-fit items-center gap-1 text-sm font-medium text-[color:var(--gooze-teal)] hover:text-[color:var(--gooze-green)]">Issue #{item.issue}<Icon name="arrow-right" class="size-3.5" aria-hidden="true" /></a>}
  {item.href && <a href={withSlash(item.href)} class="mt-auto inline-flex w-fit items-center gap-1 text-sm font-medium text-[color:var(--gooze-teal)] hover:text-[color:var(--gooze-green)]">Docs<Icon name="arrow-right" class="size-3.5" aria-hidden="true" /></a>}
</li>
