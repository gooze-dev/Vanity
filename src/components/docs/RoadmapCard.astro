---
import Icon from "@/components/Icon.astro"
import RoadmapStatus from "@/components/docs/RoadmapStatus.astro"
import { withCode } from "@/lib/faq"
import { withSlash } from "@/lib/links"

const { item } = Astro.props
---
<li id={item.id} class={item.shipped ? "flex flex-col gap-2 rounded-lg border bg-card p-4" : "flex flex-col gap-2 rounded-lg border border-dashed border-input p-4"}>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold leading-snug text-foreground" set:html={withCode(item.title)} />
    <RoadmapStatus shipped={item.shipped} beta={item.beta} />
  </div>
  <p class="leading-[1.65]">{typeof item.detail === "string" ? item.detail : <Fragment set:html={item.detail.html} />}</p>
  {item.issue && <a href={`https://github.com/gooze-dev/gooze/issues/${item.issue}`} class="mt-auto inline-flex w-fit items-center gap-1 text-sm font-medium text-accent hover:text-foreground">Issue #{item.issue}<Icon name="arrow-right" class="size-3.5" aria-hidden="true" /></a>}
  {item.href && <a href={withSlash(item.href)} class="mt-auto inline-flex w-fit items-center gap-1 text-sm font-medium text-accent hover:text-foreground">Docs<Icon name="arrow-right" class="size-3.5" aria-hidden="true" /></a>}
</li>
