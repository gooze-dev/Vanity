---
import Badge from "@/components/ui/Badge.astro"
import { withCode } from "@/lib/faq"

type Support = "yes" | "no" | "partial" | "unknown"

const { value } = Astro.props as { value: [Support, string] }
const [support, note] = value

const supportLabel: Record<Support, string> = {
  yes: "Yes",
  no: "No",
  partial: "Partly",
  unknown: "Not documented",
}

// Tags, as in IntegrationCard: the word carries the meaning, and "no" is neutral
// because a missing feature is not an error.
const supportBadge: Record<Support, { variant: "default" | "secondary" | "outline"; class?: string }> = {
  yes: { variant: "default" },
  no: { variant: "secondary" },
  partial: { variant: "outline" },
  unknown: { variant: "outline", class: "border-dashed text-muted-foreground" },
}
---
<Badge {...supportBadge[support]}>{supportLabel[support]}</Badge>{note && <div class="mt-1 text-xs text-muted-foreground" set:html={withCode(note)} />}
