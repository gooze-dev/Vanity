---
import { withCode } from "@/lib/faq"

type Support = "yes" | "no" | "partial" | "unknown"

const { value } = Astro.props as { value: [Support, string] }
const [support, note] = value

const supportLabel: Record<Support, string> = {
  yes: "Yes",
  no: "No",
  partial: "Partly",
  unknown: "Not documented",
}

// Tags, as in IntegrationCard: the word carries the meaning, and "no" is neutral
// because a missing feature is not an error.
// The ComparisonTable answer: a symbol from CSS, then the word.
const supportClass: Record<Support, string> = {
  yes: "gz-v--yes",
  no: "gz-v--no",
  partial: "gz-v--partly",
  unknown: "gz-v--unknown",
}

// A one-word flag or file name stays whole; code with spaces wraps between words.
const noteHtml = note && withCode(note).replace(/<code>([^\s<]+)<\/code>/g, '<code class="whitespace-nowrap">$1</code>')
---
<span class={`gz-v ${supportClass[support]}`}>{supportLabel[support]}</span>{note && <span class="gz-note" set:html={noteHtml} />}
