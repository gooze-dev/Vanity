---
import { cn } from "@/lib/utils"

const { owner = "gooze-dev", repo = "gooze", class: className } = Astro.props
---
<span data-latest-release={`${owner}/${repo}`} hidden class={cn("inline-flex cursor-default select-none items-center rounded-full border px-2 py-1 font-mono text-xs leading-none text-muted-foreground", className)}></span>

<script>
  const STORAGE_KEY = "gooze.latestRelease"
  const STORAGE_TTL_MS = 60 * 60 * 1000

  function show(badge: HTMLElement, tagName: string) {
    badge.textContent = tagName
    badge.hidden = false
  }

  function cachedTag(now: number) {
    try {
      const cached = JSON.parse(window.localStorage.getItem(STORAGE_KEY) ?? "null") as {
        tagName?: string
        ts?: number
      } | null
      if (cached?.tagName && cached.ts && now - cached.ts < STORAGE_TTL_MS) return cached.tagName
    } catch {
      // ignore cache errors
    }
    return null
  }

  async function load(badge: HTMLElement) {
    const now = Date.now()
    const cached = cachedTag(now)
    if (cached) {
      show(badge, cached)
      return
    }
    try {
      const response = await fetch(`https://api.github.com/repos/${badge.dataset.latestRelease}/releases/latest`, {
        headers: { Accept: "application/vnd.github+json" },
      })
      if (!response.ok) return
      const data = (await response.json()) as { tag_name?: string }
      if (!data.tag_name) return
      show(badge, data.tag_name)
      try {
        window.localStorage.setItem(STORAGE_KEY, JSON.stringify({ tagName: data.tag_name, ts: now }))
      } catch {
        // ignore cache errors
      }
    } catch {
      // ignore network errors
    }
  }

  document.addEventListener("astro:page-load", () => {
    for (const badge of document.querySelectorAll<HTMLElement>("[data-latest-release]")) load(badge)
  })
</script>
