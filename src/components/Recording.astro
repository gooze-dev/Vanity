---
import { castText, readCast } from "@/lib/recording"

type Props = {
  /** Cast name in public/casts, without .cast. */
  name: string
  /** What the recording shows, for screen readers. */
  title: string
  /** Full-screen TUI recording: play it instead of showing its text. */
  tui?: boolean
}

// Real tool output on a page, from public/casts/<name>.cast (recorded by
// scripts/record-casts.mts). Pages never copy output by hand; see
// .claude/rules/tool-output.md. Plain output is text; only a TUI needs a player.
const { name, title, tui = false } = Astro.props
const cast = readCast(name)
const header = JSON.parse(cast.slice(0, cast.indexOf("\n"))) as { height: number }
const text = castText(cast)
---
{tui ? (
  <figure data-slot="terminal-cast" data-src={`/casts/${name}.cast`} data-rows={header.height} aria-label={title} class="not-typeset my-6 overflow-hidden rounded-lg border">
    <div data-player></div>
  </figure>
) : (
  <figure data-slot="terminal-output" aria-label={title} class="my-6 overflow-hidden rounded-lg border">
    <pre class="m-0 overflow-x-auto whitespace-pre p-4 font-mono text-xs">{text}</pre>
  </figure>
)}

<script>
  // Mounts asciinema-player on each TUI recording. The player and its styles
  // load only on pages that have one.
  const posterSeconds = 2
  let players: { dispose: () => void }[] = []

  document.addEventListener("astro:before-swap", () => {
    players.forEach((player) => player.dispose())
    players = []
  })

  document.addEventListener("astro:page-load", async () => {
    const figures = document.querySelectorAll<HTMLElement>('[data-slot="terminal-cast"]')
    if (figures.length === 0) return
    const [AsciinemaPlayer] = await Promise.all([
      import("asciinema-player"),
      import("asciinema-player/dist/bundle/asciinema-player.css"),
    ])
    for (const figure of figures) {
      const target = figure.querySelector<HTMLElement>("[data-player]")
      if (!target || !figure.isConnected || target.childElementCount > 0) continue
      const player = AsciinemaPlayer.create(figure.dataset.src ?? "", target, {
        rows: Number(figure.dataset.rows),
        poster: `npt:0:${posterSeconds}`,
        idleTimeLimit: 1,
        fit: "width",
        theme: "auto/asciinema",
      })
      // A TUI recording ends by quitting, which clears the screen: don't rest on that.
      player.addEventListener("ended", () => player.seek(posterSeconds))
      players.push(player)
    }
  })
</script>
