---
import "asciinema-player/dist/bundle/asciinema-player.css"
import { castText, readCast } from "@/lib/recording"

type Props = {
  /** Cast name in public/casts, without .cast. */
  name: string
  /** What the recording shows, for screen readers. */
  title: string
  /** Full-screen TUI recording: keep the recorded terminal size. */
  tui?: boolean
}

// Real tool output on a page: plays public/casts/<name>.cast (recorded by
// scripts/record-casts.mts) and puts its text in the HTML for search engines,
// readers without JavaScript and find-in-page. Pages never copy output by
// hand; see .claude/rules/tool-output.md.
const { name, title, tui = false } = Astro.props
const cast = readCast(name)
const header = JSON.parse(cast.slice(0, cast.indexOf("\n"))) as { height: number }
const text = castText(cast)
const rows = tui ? header.height : Math.min(header.height, Math.max(2, text.split("\n").length + 1))
const poster = tui ? "npt:0:2" : "npt:0:10"
---
<figure data-slot="terminal-cast" data-src={`/casts/${name}.cast`} data-rows={rows} data-poster={poster} aria-label={title} class="my-6 overflow-hidden rounded-lg border"><div data-player></div>{tui ? null : <pre class="m-0 overflow-hidden whitespace-pre-wrap p-4 font-mono text-xs">{text}</pre>}</figure>

<script>
  // Mounts asciinema-player on each recording. Until the player loads (and
  // without JavaScript) the figure shows the recording's text, which stays for
  // screen readers afterwards.
  let players: { dispose: () => void }[] = []

  document.addEventListener("astro:before-swap", () => {
    players.forEach((player) => player.dispose())
    players = []
  })

  document.addEventListener("astro:page-load", () => {
    const figures = document.querySelectorAll<HTMLElement>('[data-slot="terminal-cast"]')
    if (figures.length === 0) return
    import("asciinema-player").then((AsciinemaPlayer) => {
      for (const figure of figures) {
        const target = figure.querySelector<HTMLElement>("[data-player]")
        if (!target || !figure.isConnected || target.childElementCount > 0) continue
        players.push(
          AsciinemaPlayer.create(figure.dataset.src ?? "", target, {
            rows: Number(figure.dataset.rows),
            poster: figure.dataset.poster,
            idleTimeLimit: 1,
            fit: "width",
            theme: "auto/asciinema",
          }),
        )
        const text = figure.querySelector("pre")
        if (text) text.className = "sr-only"
      }
    })
  })
</script>
