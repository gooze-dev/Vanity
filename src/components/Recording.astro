---
import TerminalCast from "@/components/TerminalCast.astro"
import TerminalWindow from "@/components/TerminalWindow.astro"
import { readCast, recordingDir } from "@/lib/recording"

type Props = {
  /** Cast name in public/casts, without .cast. */
  name: string
  /** What the recording shows, for screen readers. */
  title: string
  /** Full-screen TUI recording: play it instead of showing its text. */
  tui?: boolean
}

// Real tool output on a page, from public/casts/<name>.cast (recorded by
// scripts/record-casts.mts). Pages never copy output by hand; see
// .claude/rules/tool-output.md. Plain output is text; only a TUI needs a player.
const { name, title, tui = false } = Astro.props
const cast = readCast(name)
const header = JSON.parse(cast.slice(0, cast.indexOf("\n"))) as { height: number }
---
{tui ? (
  <TerminalCast src={`/casts/${name}.cast`} rows={header.height} title={title} dir={recordingDir(name)} />
) : (
  <TerminalWindow name={name} title={title} />
)}
