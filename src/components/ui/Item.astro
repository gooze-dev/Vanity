---
import { itemVariants } from "@/lib/variants"
import { cn } from "@/lib/utils"

// Renders a link when given href. linkClass is appended as is.
const { class: className, linkClass, variant = "default", size = "default", href, ...props } = Astro.props
const Tag = href ? "a" : "div"
const classes = [cn(itemVariants({ variant, size, className })), linkClass].filter(Boolean).join(" ")
---
<Tag data-slot="item" data-variant={variant} data-size={size} class={classes} href={href} {...props}><slot /></Tag>
