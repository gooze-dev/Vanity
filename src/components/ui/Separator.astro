---
import { cn } from "@/lib/utils"

const { class: className, orientation = "horizontal" } = Astro.props
---
<div data-slot="separator" role="none" data-orientation={orientation} class={cn("shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch", className)}></div>
