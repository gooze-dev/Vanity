---
import Icon from "@/components/Icon.astro"
import PartnerLogo from "@/components/PartnerLogo.astro"
import { cn } from "@/lib/utils"

const { class: className } = Astro.props
---
{/* Pill in the Why now band, the one route to the Claude Code plugin docs. The
    whole pill links to the Claude Code docs page, which has the install
    commands. It glows softly to draw the eye, and stays still for readers who reduce motion. */}
<a href="/docs/claude-code/" class={cn("group inline-flex max-w-full animate-claude-glow motion-reduce:animate-none items-center gap-2 rounded-full max-sm:rounded-lg max-sm:text-[13px] border border-[#D97757]/40 bg-[#D97757]/10 py-1 pl-1.5 pr-3 text-sm text-foreground transition-colors hover:border-[#D97757]/70 hover:bg-[#D97757]/15", className)}>
  <PartnerLogo name="claude" size={16} class="ml-1" />
  <span class="rounded-full bg-[#D97757] px-2 py-0.5 text-xs font-semibold text-brand-ink">New</span>
  <span>Set up the Claude Code plugin (beta)</span>
  <Icon name="arrow-right" class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
</a>
