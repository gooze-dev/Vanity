---
// A full-screen TUI recording, played with asciinema-player.
const { src, rows, title } = Astro.props as { src: string; rows: number; title: string }
---
<figure data-slot="terminal-cast" data-src={src} data-rows={rows} aria-label={title} class="gz-cast not-typeset my-6">
  <div data-player></div>
</figure>

<script>
  // Mounts asciinema-player on each TUI recording. The player and its styles
  // load only on pages that have one.
  const posterSeconds = 2
  const terminalFont = "Geist Mono Variable"
  let players: { dispose: () => void }[] = []

  document.addEventListener("astro:before-swap", () => {
    players.forEach((player) => player.dispose())
    players = []
  })

  document.addEventListener("astro:page-load", async () => {
    const figures = document.querySelectorAll<HTMLElement>('[data-slot="terminal-cast"]')
    if (figures.length === 0) return
    const [AsciinemaPlayer] = await Promise.all([
      import("asciinema-player"),
      import("asciinema-player/dist/bundle/asciinema-player.css"),
      // The player measures a character once, so the font has to be ready.
      document.fonts.load(`13px "${terminalFont}"`),
    ])
    for (const figure of figures) {
      const target = figure.querySelector<HTMLElement>("[data-player]")
      if (!target || !figure.isConnected || target.childElementCount > 0) continue
      const player = AsciinemaPlayer.create(figure.dataset.src ?? "", target, {
        rows: Number(figure.dataset.rows),
        poster: `npt:0:${posterSeconds}`,
        idleTimeLimit: 1,
        fit: "width",
        theme: "gooze",
        terminalFontFamily: `"${terminalFont}", ui-monospace, monospace`,
        // Geist Mono's vertical box line is 1.32em tall but starts below the top
        // of the default 1.33em row. A row of 1.25em lets it meet the next one.
        terminalLineHeight: 1.25,
      })
      // A TUI recording ends by quitting, which clears the screen: don't rest on that.
      player.addEventListener("ended", () => player.seek(posterSeconds))
      players.push(player)
    }
  })
</script>
