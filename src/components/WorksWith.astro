---
import PartnerLogo from "@/components/PartnerLogo.astro"

// Where Gooze runs: official-logo chips linking to their docs. Tools still to come
// follow the shipped ones as dashed chips that are shown but never clickable.
const groups = [
  { label: "Agents", items: [
    { name: "Claude Code", logo: "claude", href: "/docs/claude-code/" },
    { name: "Codex", logo: "codex" },
    { name: "opencode", logo: "opencode" },
  ] },
  { label: "CI", items: [
    { name: "GitHub Actions", logo: "github-actions", href: "/docs/ci/github/" },
    { name: "GitLab CI", logo: "gitlab", href: "/docs/ci/gitlab/" },
  ] },
  { label: "Editors, via goozels", items: [
    { name: "VS Code", logo: "vscode", href: "/docs/editor-support/" },
    { name: "Neovim", logo: "neovim", href: "/docs/editor-support/" },
    { name: "GoLand", logo: "goland", href: "/docs/editor-support/" },
  ] },
] as const
---
<dl class="gz-l__works">
    {groups.map((group) => (
      <div>
        <dt>{group.label}</dt>
        <dd>{group.items.map((item) => "href" in item
          ? <a href={item.href} class="gz-works__name"><PartnerLogo name={item.logo} />{item.name}</a>
          : <span class="gz-works__name gz-works__name--soon" aria-disabled="true"><PartnerLogo name={item.logo} />{item.name}<span class="soon">Coming soon</span></span>)}</dd>
      </div>
    ))}
</dl>
