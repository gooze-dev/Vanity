---
import iconLight from "@/assets/logo/gooze-icon-light.svg"
import colorMark from "@/assets/logo/gooze-mark.svg"
import { cn } from "@/lib/utils"

// The Lockup: colour mark on dark, the Gopher Blue tile on light. mark={false}
// leaves the wordmark alone, for a place that shows the mark separately. A slot
// continues the wordmark (goozels).
const { class: className, mark = true } = Astro.props
const ColorMark = colorMark
const IconLight = iconLight
---
{mark ? (
  <span class={cn("gz-lockup", className)}><ColorMark class="hidden dark:block" aria-hidden="true" /><IconLight class="dark:hidden" aria-hidden="true" /><span class="gz-wordmark"><span class="go">Go</span><span class="oze">oze<slot /></span></span></span>
) : (
  <span class={cn("gz-wordmark", className)}><span class="go">Go</span><span class="oze">oze<slot /></span></span>
)}
