---
import { recordingText } from "@/lib/recording"

// What the Claude Code plugin does, as three steps. Step 2 is the hook's real
// output (additionalContext in public/casts/calc-hook-claude.cast), step 3 the
// score from the fixed run; no lines are written for the agent.
const hook = JSON.parse(recordingText("calc-hook-claude")) as { hookSpecificOutput: { additionalContext: string } }
const score = recordingText("calc-fixed-score").match(/\d+\.\d+%/)?.[0]

function escapeHtml(text: string) {
  return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
}

const diag = hook.hookSpecificOutput.additionalContext
  .split("\n")
  .map((line) =>
    escapeHtml(line)
      .replace(/warning:/, '<span class="w">warning:</span>')
      .replace(/`([^`]*)` → `([^`]*)`/, '`<span class="o">$1</span>` → `<span class="m">$2</span>`'),
  )
  .join("\n")

const step = "flex flex-col gap-3 rounded-lg border bg-muted p-6"
---
<div class="grid gap-4 lg:grid-cols-[1fr_1.6fr_1fr]">
  <div class={step}><span class="gz-eyebrow">1 · You ask</span><p class="text-lg leading-[1.45]">&ldquo;Kill the surviving mutants in <code>InRange</code> only.&rdquo;</p></div>
  <div class={step}><span class="gz-eyebrow">2 · After each edit, Claude sees</span><pre class="gz-diag" set:html={diag} /></div>
  <div class={step}><span class="gz-eyebrow">3 · Two boundary tests later</span><span class="font-display text-6xl font-bold text-brand-toxic">{score}</span><span class="text-sm text-muted-foreground">mutation score</span></div>
</div>
<div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">In a Claude Code session:
  <span class="gz-cmd"><span class="s">/plugin</span> marketplace add gooze-dev/claude-plugin</span>
  <span class="gz-cmd"><span class="s">/plugin</span> install gooze@gooze</span>
  <span class="gz-cmd"><span class="s">/gooze:mutation-testing</span></span>
</div>
