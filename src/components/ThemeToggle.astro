---
import Icon from "@/components/Icon.astro"
import Button from "@/components/ui/Button.astro"
---
<Button data-theme-toggle variant="ghost" size="icon" type="button" class="h-9 w-9"><Icon name="sun" class="h-4 w-4 rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0" /><Icon name="moon" class="absolute h-4 w-4 rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100" /><span class="sr-only">Toggle theme</span></Button>

<script>
  // The saved choice lives in localStorage "theme" (light or dark; absent means
  // dark, the default). The base layout applies it before the first paint.
  const root = document.documentElement

  function apply(theme: string) {
    // Switch without running every color transition on the page.
    const style = document.createElement("style")
    style.textContent = "*,*::before,*::after{transition:none!important}"
    document.head.append(style)
    root.setAttribute("data-theme", theme)
    root.style.colorScheme = theme
    window.getComputedStyle(document.body)
    window.setTimeout(() => style.remove(), 1)
  }

  // Delegated: the toggle is replaced on every client navigation.
  document.addEventListener("click", (event) => {
    if (!(event.target as Element).closest("[data-theme-toggle]")) return
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark"
    try {
      localStorage.setItem("theme", next)
    } catch {
      // The choice just doesn't persist.
    }
    apply(next)
  })

  window.addEventListener("storage", (event) => {
    if (event.key === "theme") apply(event.newValue === "light" ? "light" : "dark")
  })
</script>
